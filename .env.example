# ZeroGuard Environment Configuration
# Supported providers: groq | gemini | ollama
LLM_PROVIDER=groq

# 1. Groq Cloud (Free Tier) - Primary Default
# Sign up at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Google Gemini (Free Tier) - Alternative Cloud
# Sign up at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# 3. Ollama Local Endpoint - Local Fallback
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","*"]
