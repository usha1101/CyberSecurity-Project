# ZeroGuard Frontend Environment Configuration Example
# Copy this file to .env inside the frontend/ folder if you wish to override defaults.

# Port for frontend static server (node server.js)
PORT=3000

# Backend FastAPI Server Connection (for reverse proxy in server.js)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Centralized API Base URL for ZeroGuard Client (api.js / config.js)
# Can be direct: http://localhost:8000/api/v1
# Or proxy: http://localhost:3000/api/v1
BACKEND_URL=http://localhost:8000/api/v1
